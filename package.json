  "devDependencies": {
    "@wordpress/block-serialization-default-parser": "5.52.0",
    "@wp-playground/blueprints": "3.1.46",
    "@wp-playground/cli": "3.1.46",
    "docspress": "https://github.com/Automattic/docspress/archive/517050b6aceb09cacd7dc66c0df2023718e57bd9.tar.gz",
    "yaml": "2.9.0"
  }
}
